// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ===== Customizer models =====

model CustomizerConfig {
  id          String            @id @default(cuid())
  shop        String
  productId   String
  enabled     Boolean           @default(true)
  baseImageUrl String?
  maskImageUrl String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  groups      CustomizerGroup[]

  @@unique([shop, productId])
  @@index([shop])
}

model CustomizerGroup {
  id        String              @id @default(cuid())
  configId  String
  name      String
  type      String              // color | size | text | number | upload | addon
  required  Boolean             @default(false)
  zIndex    Int                 @default(0)
  position  Int                 @default(0)
  maxLength Int?                // for text/number
  config    CustomizerConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  options   CustomizerOption[]

  @@index([configId])
}

model CustomizerOption {
  id        String          @id @default(cuid())
  groupId   String
  label     String
  value     String
  iconUrl   String?
  layerUrl  String?
  colorHex  String?
  price     Float           @default(0)
  position  Int             @default(0)
  group     CustomizerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model SavedDesign {
  id         String   @id @default(cuid())
  shop       String
  productId  String
  selections String   // JSON: { groupId: { optionId, value, ... } }
  previewUrl String?
  totalPrice Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([shop, productId])
}
